{
  "configVersion": "v3",
  "app": {
    "appId": 1137488,
    "appName": "Barometer",
    "appType": "app",
    "version": { "code": 13, "name": "1.1.5" },
    "icon": "icon.png",
    "vender": "Balance Barometer",
    "description": "Barometer 1.1.5 for Amazfit Balance"
  },
  "permissions": ["device:os.barometer", "device:os.alarm", "device:os.bg_service", "device:os.local_storage"],
  "runtime": {
    "apiVersion": { "compatible": "3.0.0", "target": "3.0.0", "minVersion": "3.0.0" }
  },
  "targets": {
    "balance": {
      "module": {
        "page": { "pages": ["page/index"] },
        "app-side": { "path": "app-side/index" },
        "setting": { "path": "setting/index" },
        "app-service": { "services": ["app-service/pressure-history"] }
      },
      "platforms": [
        { "name": "amazfit-balance", "deviceSource": 8519936 },
        { "name": "amazfit-balance", "deviceSource": 8519937 },
        { "name": "amazfit-balance", "deviceSource": 8519939 }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "en-US": { "appName": "Barometer" },
    "ru-RU": { "appName": "Барометр" }
  },
  "defaultLanguage": "en-US"
}
